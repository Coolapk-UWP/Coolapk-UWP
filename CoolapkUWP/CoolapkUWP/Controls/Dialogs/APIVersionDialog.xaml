<ContentDialog
    x:Class="CoolapkUWP.Controls.Dialogs.APIVersionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoolapkUWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CoolapkUWP.Controls.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="/ContentDialog/APIVersionDialog"
    Closing="OnClosing"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <local:Int32ToStringConverter x:Key="Int32ToStringConverter" />
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem
                x:Uid="/ContentDialog/UpdateVersionItem"
                Click="MenuFlyoutItem_Click"
                Tag="Refresh">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE117;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </ContentDialog.ContextFlyout>
    <controls:StackPanel Spacing="4">
        <TextBox
            x:Uid="/ContentDialog/APIVersionTextBox"
            PlaceholderText="9.2.2"
            Text="{x:Bind APIVersion.Version, Mode=TwoWay}" />
        <TextBox
            x:Uid="/ContentDialog/APIVersionCodeTextBox"
            PlaceholderText="1905301"
            Text="{x:Bind APIVersion.VersionCode, Converter={StaticResource Int32ToStringConverter}, Mode=TwoWay}" />
    </controls:StackPanel>
</ContentDialog>
